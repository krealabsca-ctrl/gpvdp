# Copiar a .env (NO se commitea). Valores de ejemplo para desarrollo local.

# ---- Backend ----
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://gpvdp:localdev@db:5432/gpvdp?sslmode=disable

# Secreto para firmar JWT. En producción usar un valor largo y aleatorio.
JWT_SECRET=cambia-esto-en-produccion-usa-un-secreto-largo-y-aleatorio

# Vigencia de tokens
ACCESS_TTL=15m
REFRESH_TTL=720h

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Sembrar datos base (3 empresas + roles + admin) al arrancar si la BD está vacía
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@gpvdp.local
SEED_ADMIN_PASSWORD=admin1234

# Cierre de período bloqueante: si true, no se cierra con movimientos "No identificado"
CIERRE_PERIODO_BLOQUEANTE=true

# ---- Frontend ----
VITE_API_URL=http://localhost:8080
